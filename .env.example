# Copiar a .env. El laboratorio es local: estas credenciales no son secretas
# y no deben reemplazarse por credenciales reales en ningun momento.
DATABASE_URL=postgres://lab:lab@localhost:5433/whatsapp_lab
TEST_DATABASE_URL=postgres://lab:lab@localhost:5433/whatsapp_lab_test

# Tamano del pool. Acotado a proposito: una base lenta no puede crear espera infinita.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

PORT=3000
